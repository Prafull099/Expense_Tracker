# Root-level gitignore for Expense Tracker Monorepo

# Secrets & Local Configuration — NEVER COMMIT
**/application-local.properties
**/application-*.properties
!**/application.properties
!**/application.properties.example
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12

# Dependencies & Build Artifacts
**/node_modules/
**/dist/
**/dist-ssr/
**/target/
**/build/
.mvn/wrapper/maven-wrapper.jar

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Environment
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor caches
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.sts4-cache
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

